{
  "name": "mathquant-lab",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "纯前端的股市数学模型分析终端：可交互、可回测、可解释，覆盖 A股/港股/美股/日股/韩股",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "playwright-core": "^1.64.0",
    "typescript": "~5.6.2",
    "vitest": "^2.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickilchen/MathQuant_Lab.git"
  },
  "homepage": "https://nickilchen.github.io/MathQuant_Lab/",
  "bugs": {
    "url": "https://github.com/nickilchen/MathQuant_Lab/issues"
  },
  "author": "MathQuant Lab contributors",
  "engines": {
    "node": ">=20.18.1"
  },
  "license": "MIT",
  "keywords": [
    "stock",
    "quant",
    "technical-analysis",
    "valuation",
    "sentiment",
    "react",
    "typescript",
    "vite"
  ]
}
